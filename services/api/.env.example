# =============================================================================
# DWAOP - Department Workflow Academy Operation Platform
# Backend API Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---- Server ----
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deptwp_platform
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ---- JWT (REQUIRED - generate secure random strings) ----
# Generate with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_random_secret_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_random_secret_string
JWT_REFRESH_EXPIRES_IN=7d

# ---- Redis (Optional - for session caching and rate limiting) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Email (SMTP for notifications and password resets) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ---- File Uploads ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- Logging ----
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ---- WebSocket ----
WS_PORT=3002

# ---- Audit ----
AUDIT_RETENTION_DAYS=365

# ---- Workflow Engine ----
WORKFLOW_TIMEOUT_HOURS=24
WORKFLOW_ESCALATION_HOURS=48
