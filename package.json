{
  "name": "department-workflow-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=services/api",
    "build:all": "npm run build && npm run build:api",
    "lint": "npm run lint --workspace=apps/web",
    "test": "npm run test --workspace=services/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
